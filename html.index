  <style>
    :root {
      --ink: #18233f;
      --muted: #58657b;
      --paper: #f7f8fc;
      --white: #ffffff;
      --blue: #3157d5;
      --purple: #7654d6;
      --teal: #168f91;
      --orange: #e58a35;
      --pink: #d9578b;
      --line: #e3e8f2;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      background: var(--paper);
      color: var(--ink);
      line-height: 1.65;
    }
    .hero {
      color: white;
      padding: 58px 22px 46px;
      background: radial-gradient(circle at 85% 20%, #5d83ff 0, transparent 28%),
                  linear-gradient(135deg, #172554, #3157d5 58%, #7654d6);
    }
    .hero-inner, main, footer { max-width: 1050px; margin: auto; }
    .eyebrow {
      display: inline-block; padding: 6px 12px; border-radius: 999px;
      background: #ffffff20; border: 1px solid #ffffff45;
      font-size: .82rem; letter-spacing: .08em; text-transform: uppercase;
    }
    h1 { font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.12; margin: 18px 0 10px; }
    .hero p { max-width: 700px; margin: 0; color: #e7ecff; }
    .student-card {
      display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px;
    }
    .student-card span {
      padding: 10px 15px; border-radius: 12px;
      background: #ffffff18; border: 1px solid #ffffff35;
    }
    main { padding: 30px 20px 55px; }
    .overview {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px; margin: 0 0 28px;
    }
    .overview-card {
      background: var(--white); padding: 20px; border-radius: 17px;
      border: 1px solid var(--line); box-shadow: 0 7px 22px #18233f08;
    }
    .overview-card h2 { margin: 0 0 8px; font-size: 1.1rem; }
    .overview-card p { margin: 0; color: var(--muted); font-size: .94rem; }
    .overview-card:nth-child(1) { border-top: 4px solid var(--blue); }
    .overview-card:nth-child(2) { border-top: 4px solid var(--teal); }
    .overview-card:nth-child(3) { border-top: 4px solid var(--orange); }
    .section-title { margin: 38px 0 16px; font-size: 1.55rem; }
    .question {
      background: white; border: 1px solid var(--line); border-radius: 18px;
      overflow: hidden; margin: 17px 0; box-shadow: 0 7px 24px #18233f08;
    }
    .question-head {
      display: flex; align-items: center; gap: 12px; padding: 17px 20px;
      color: white;
    }
    .question-head h3 { margin: 0; font-size: 1.08rem; }
    .number {
      flex: 0 0 40px; height: 40px; display: grid; place-items: center;
      border-radius: 12px; background: #ffffff25; font-weight: 800;
    }
    .q1 .question-head { background: linear-gradient(100deg, #3157d5, #6485f5); }
    .q2 .question-head { background: linear-gradient(100deg, #087f8c, #2db7a3); }
    .q3 .question-head { background: linear-gradient(100deg, #b96b17, #f0a84c); }
    .q4 .question-head { background: linear-gradient(100deg, #7654d6, #a78bfa); }
    .q5 .question-head { background: linear-gradient(100deg, #b83280, #ec78b4); }
    .q6 .question-head { background: linear-gradient(100deg, #166534, #4caf7b); }
    .q7 .question-head { background: linear-gradient(100deg, #334155, #64748b); }
    .q8 .question-head { background: linear-gradient(100deg, #c2410c, #fb923c); }
    .question-body { padding: 20px 22px 23px; }
    .question-body p:first-child { margin-top: 0; }
    .question-body p:last-child { margin-bottom: 0; }
    .question-body h4 { margin: 19px 0 8px; color: var(--ink); }
    .question-body ul, .question-body ol { padding-left: 23px; }
    .question-body li { margin: 5px 0; }
    .tag {
      display: inline-block; border-radius: 7px; padding: 3px 8px;
      font-size: .78rem; font-weight: 700; background: #eef2ff; color: #3157d5;
      margin-bottom: 10px;
    }
    .table-wrap { overflow-x: auto; margin: 14px 0; }
    table { width: 100%; border-collapse: collapse; min-width: 500px; }
    th, td { border: 1px solid var(--line); text-align: left; padding: 10px 12px; }
    th { background: #f0f3ff; }
    .note { background: #f1f7ff; border-left: 4px solid var(--blue); padding: 12px 15px; border-radius: 8px; }
    .flow {
      display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 15px 0;
    }
    .flow span { background: #eef2ff; border: 1px solid #cdd8ff; padding: 9px 12px; border-radius: 9px; font-weight: 650; }
    .flow b { color: var(--blue); }
    .footer { text-align: center; color: var(--muted); padding: 22px; border-top: 1px solid var(--line); }
    @media (max-width: 560px) {
      .hero { padding-top: 38px; }
      .question-body { padding: 16px; }
      .question-head { padding: 14px 16px; }
    }
    @media print {
      body { background: white; }
      .hero { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      .question, .overview-card { box-shadow: none; break-inside: avoid; }
    }
  </style>
</head>
<body>
